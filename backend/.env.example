# ──────────────────────────────────────────────────────────────
# RAG Technical Documentation Assistant — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Groq API (Required) ────────────────────────────────────────
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── LLM Configuration ─────────────────────────────────────────
# Available Groq models:
#   llama3-70b-8192     (recommended — most capable)
#   llama3-8b-8192      (faster, less capable)
#   llama-3.1-70b-versatile
#   llama-3.1-8b-instant
#   mixtral-8x7b-32768
GROQ_MODEL=llama3-70b-8192
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# ── Embedding Model ────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ── ChromaDB ──────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=technical_docs

# ── Retrieval ─────────────────────────────────────────────────
RETRIEVAL_TOP_K=5

# ── FastAPI Server ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── Feedback Storage ──────────────────────────────────────────
FEEDBACK_STORE_PATH=./data/feedback.json

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
